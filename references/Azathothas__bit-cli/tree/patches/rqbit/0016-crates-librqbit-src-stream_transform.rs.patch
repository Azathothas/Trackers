+//! A seam for wrapping a peer connection before the BitTorrent handshake.
+//!
+//! Everything a peer connection does happens over two halves that this crate
+//! owns: it dials, or accepts, and then writes a handshake. A dependent crate
+//! that wants to put something between the socket and the protocol, which is
+//! what message stream encryption is, has nowhere to stand.
+//!
+//! This is that place. A session may carry one [`StreamTransform`], and it is
+//! called once per connection in each direction, before any protocol byte
+//! crosses it.
+//!
+//! Two things about the shape are not obvious.
+//!
+//! **The accepting side is handed every info hash the session holds.** MSE
+//! keys its handshake on the info hash, and the info hash is not known until
+//! the possibly-encrypted handshake has been read, so the transform resolves
+//! it against the candidates rather than being told.
+//!
+//! **The dialling side may ask for the connection to be made again.** A
+//! transform that negotiates something the peer does not speak has spent the
+//! connection finding that out, and the only recovery is a fresh one.
+//! [`OutgoingTransform::RetryPlaintext`] is that answer, and the caller redials
+//! once with the transform skipped.
+//!
+//! Added by this fork. See `patches/UPSTREAM.md` and `TODO/peers.md` T-163.
+
+use std::future::Future;
+use std::net::SocketAddr;
+use std::pin::Pin;
+
+use librqbit_core::hash_id::Id20;
+
+pub use crate::type_aliases::{BoxAsyncReadVectored, BoxAsyncWrite};
+
+/// The future a transform returns.
+///
+/// Spelled out rather than `futures::future::BoxFuture` so that a crate
+/// implementing this trait needs nothing but `std` to name the return type.
+pub type TransformFuture<'a, T> = Pin<Box<dyn Future<Output = anyhow::Result<T>> + Send + 'a>>;
+
+/// What a transform did with an outgoing connection.
+pub enum OutgoingTransform {
+    /// Use these halves from here on. They may be the ones handed in.
+    Stream(BoxAsyncReadVectored, BoxAsyncWrite),
+    /// This connection is spent. Dial again, and do not call the transform on
+    /// the second attempt.
+    RetryPlaintext,
+}
+
+impl std::fmt::Debug for OutgoingTransform {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            OutgoingTransform::Stream(..) => f.write_str("Stream"),
+            OutgoingTransform::RetryPlaintext => f.write_str("RetryPlaintext"),
+        }
+    }
+}
+
+pub trait StreamTransform: Send + Sync + std::fmt::Debug {
+    /// Called after dialling `addr` for `info_hash`, before the handshake is
+    /// written.
+    fn outgoing<'a>(
+        &'a self,
+        addr: SocketAddr,
+        info_hash: Id20,
+        read: BoxAsyncReadVectored,
+        write: BoxAsyncWrite,
+    ) -> TransformFuture<'a, OutgoingTransform>;
+
+    /// Called after accepting from `addr`, before the handshake is read.
+    ///
+    /// `info_hashes` is every torrent the session holds, because which one
+    /// this connection is for is not known yet.
+    fn incoming<'a>(
+        &'a self,
+        addr: SocketAddr,
+        info_hashes: Vec<Id20>,
+        read: BoxAsyncReadVectored,
+        write: BoxAsyncWrite,
+    ) -> TransformFuture<'a, (BoxAsyncReadVectored, BoxAsyncWrite)>;
+}
