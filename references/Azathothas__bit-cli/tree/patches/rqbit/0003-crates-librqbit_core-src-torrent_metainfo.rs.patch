+/// Detect the encoding of a torrent's names from the raw bytes of its `name`
+/// and of every `path` component, in that order.
+///
+/// A free function rather than a method so a second reader of the same torrent
+/// reaches the same answer by calling this rather than by reimplementing it.
+/// `bit-cli` parses metainfo itself and used to decode names lossily, which
+/// made its `info`, `files` and `webseed list` reports disagree with what the
+/// same run then wrote to disk. See `TODO/bep-coverage.md`, T-103.
+pub fn detect_encoding_of<'a>(parts: impl IntoIterator<Item = &'a [u8]>) -> &'static Encoding {
+    let mut encdetect = chardetng::EncodingDetector::new(chardetng::Iso2022JpDetection::Deny);
+    for part in parts {
+        encdetect.feed(part, false);
+    }
+    encdetect.guess(None, chardetng::Utf8Detection::Allow)
+}
+
+/// The `.utf-8` twin of a name or a path, when there is one and it is what it
+/// says it is.
+///
+/// A twin that is not valid UTF-8 is a creator that wrote the key without
+/// meaning it, and there is nothing to prefer it for: the raw key and the
+/// detected encoding are the better answer. An empty component list is the
+/// same case, because a name of no components names nothing.
+fn utf8_twin<BufType: AsRef<[u8]>>(twin: Option<&[BufType]>) -> Option<&[BufType]> {
+    let twin = twin.filter(|parts| !parts.is_empty())?;
+    twin.iter()
+        .all(|part| std::str::from_utf8(part.as_ref()).is_ok())
+        .then_some(twin)
+}
